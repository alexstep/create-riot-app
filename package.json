{
  "name": "create-riot-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Riot.js application starter. A create-react-app style CLI (bun create) and a demo with a drawer, sounds, and screens.",
  "bin": {
    "create-riot-app": "./bin/create-riot-app.ts"
  },
  "scripts": {
    "create": "bun ./bin/create-riot-app.ts",
    "demo": "bun run --cwd template dev",
    "demo:build": "bun run --cwd template build",
    "demo:typecheck": "bun run --cwd template typecheck",
    "visual": "bun run --cwd visual test"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
