<icon>
  <span></span>

  <script lang="ts">
    import { withTypes, type RiotComponent } from 'riot';
    import { iconSvg } from '../icons';

    interface Props {
      src: string;
    }

    interface Icon extends RiotComponent<Props, Record<string, never>> {
      paint(): void;
    }

    export default withTypes<Icon>({
      paint() {
        const src = this.props.src;
        if (
          this.root.getAttribute('data-src') === src &&
          this.root.querySelector('svg')
        )
          return;
        // Same shape as the old svg-inline-loader output: the svg is the only child.
        this.root.innerHTML = iconSvg(src).replace(
          /\s(?:width|height)="[^"]*"/g,
          '',
        );
        this.root.setAttribute('data-src', src);
      },
      onMounted() {
        this.paint();
      },
      onUpdated() {
        this.paint();
      },
    });
  </script>
</icon>
