{
  "name": "riot-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Riot.js demo: drawer, sounds, and three screens",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@riotjs/route": "10.0.0",
    "riot": "10.1.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@riotjs/compiler": "10.0.5",
    "@riotjs/hot-reload": "10.0.0",
    "@riotjs/parser": "10.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "rollup-plugin-riot": "10.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  },
  "bun-create": {
    "start": "bun run dev"
  }
}
