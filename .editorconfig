# Editor settings.
#
# JetBrains IDEs, BBEdit, Coda, and SourceLair read this file with no extra setup.
#
# For other editors, install the plugin listed at http://editorconfig.org.
root = true

[*]
charset                  = utf-8
indent_style             = space
indent_size              = 2
end_of_line              = lf
trim_trailing_whitespace = true
insert_final_newline     = true
