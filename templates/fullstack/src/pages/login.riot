<login>
  <h1>Log in</h1>
  <p if="{props.password}">
    Any email. Password: <code>{props.password}</code>
  </p>
  <p if="{!props.password}">
    Any email, and the demo password from the environment.
  </p>
  <login-form password="{props.password}"></login-form>

  <script lang="ts">
    import { withTypes, type RiotComponent } from 'riot';

    interface Props {
      password?: string;
    }

    export default withTypes<RiotComponent<Props>>({
      state: {},
    });
  </script>
</login>
