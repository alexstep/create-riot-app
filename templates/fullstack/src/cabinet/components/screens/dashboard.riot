<dashboard>
  <div class="screen screen-dashboard" id="screen_dashboard">
    <h1>Dashboard !!!</h1>
    <p class="signed-in" if="{state.email}">Signed in as {state.email}</p>
    <form class="item-form" onsubmit="{addItem}">
      <input name="title" placeholder="New item" required />
      <button type="submit">Add</button>
    </form>
    <ul class="items">
      <li each="{item in state.items}" key="{item.id}">
        <span>{item.title}</span>
        <button type="button" data-id="{item.id}" onclick="{removeClick}">Remove</button>
      </li>
    </ul>
  </div>

  <script lang="ts">
    import { withTypes, type RiotComponent } from 'riot';
    import {
      createItem,
      currentEmail,
      deleteItem,
      listItems,
      type Item,
    } from '../../../client/api';

    interface State {
      email: string;
      items: Item[];
    }

    export default withTypes<RiotComponent<object, State>>({
      state: { email: '', items: [] },
      async onMounted() {
        const email = await currentEmail();
        const items = await listItems();
        this.update({ email, items });
      },
      async addItem(event: Event) {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const title = String(new FormData(form).get('title') ?? '');
        const item = await createItem(title);
        if (!item) return;
        this.update({ items: this.state.items.concat(item) });
        form.reset();
      },
      async removeClick(event: Event) {
        const id = (event.currentTarget as HTMLButtonElement).dataset.id ?? '';
        if (!(await deleteItem(id))) return;
        this.update({ items: this.state.items.filter((item) => item.id !== id) });
      },
    });
  </script>
</dashboard>
