<subscribe-form>
  <p class="hint" if="{props.hint}">{props.hint}</p>
  <form onsubmit="{send}">
    <label>
      Email
      <input name="email" type="email" required />
    </label>
    <label>
      Message
      <input name="message" required />
    </label>
    <button type="submit">Send</button>
    <p if="{state.note}">{state.note}</p>
  </form>

  <script lang="ts">
    import { withTypes, type RiotComponent } from 'riot';
    import { sendContact } from '../client/api';

    interface Props {
      hint: string;
    }

    interface State {
      note: string;
    }

    export default withTypes<RiotComponent<Props, State>>(() => ({
      state: { note: '' },
      async send(event: Event) {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const data = new FormData(form);
        const ok = await sendContact(
          String(data.get('email') ?? ''),
          String(data.get('message') ?? ''),
        );
        this.update({ note: ok ? 'Sent.' : 'Could not send.' });
      },
    }));
  </script>

  <style>
    :host .hint {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.5;
    }

    :host form {
      display: grid;
      gap: 14px;
    }

    label {
      display: grid;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
    }

    input,
    button {
      font: inherit;
    }

    input {
      width: 100%;
      box-sizing: border-box;
      padding: 10px 12px;
      border: 1px solid var(--switch-border);
      border-radius: 8px;
      background: var(--switch-bg);
      color: var(--card-text);
    }

    button {
      width: fit-content;
      background: var(--main-bg);
      color: var(--text-on-main);
      border: 0;
      border-radius: 8px;
      padding: 10px 16px;
      font-weight: 600;
      cursor: pointer;
    }

    p {
      margin: 0;
      font-size: 14px;
    }
  </style>
</subscribe-form>
