<theme-toggle>
  <button type="button" onclick="{cycle}">{state.label}</button>

  <script lang="ts">
    import { withTypes, type RiotComponent } from 'riot';
    import {
      getThemeChoice,
      setThemeChoice,
      type ThemeChoice,
    } from '../cabinet/theme';

    const order: ThemeChoice[] = ['light', 'dark', 'system'];

    interface Props {
      isServer?: boolean;
    }

    interface State {
      label: string;
    }

    export default withTypes<RiotComponent<Props, State>>(() => ({
      state: { label: 'Theme' },
      onBeforeMount(props) {
        // The server does not know localStorage. The inline script already
        // wrote the same label the browser will bind here.
        if (props.isServer) return;
        this.state.label = `Theme: ${getThemeChoice()}`;
      },
      cycle(event: Event) {
        event.preventDefault();
        const current = getThemeChoice();
        const next = order[(order.indexOf(current) + 1) % order.length] ?? 'system';
        setThemeChoice(next);
        this.update({ label: `Theme: ${next}` });
      },
    }));
  </script>

  <style>
    :host {
      display: inline-block;
    }

    button {
      border: 1px solid var(--line);
      border-radius: 999px;
      background: transparent;
      color: var(--muted);
      padding: 4px 10px;
      font: inherit;
      font-size: 13px;
      cursor: pointer;
    }
  </style>
</theme-toggle>
