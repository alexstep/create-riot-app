<login-form>
  <form onsubmit="{send}">
    <label>
      Email
      <input name="email" type="email" required value="ada@example.com" />
    </label>
    <label>
      Password
      <input
        name="password"
        type="password"
        required
        value="{props.password || ''}"
      />
    </label>
    <button type="submit">Log in</button>
    <p if="{state.error}">{state.error}</p>
  </form>

  <script lang="ts">
    import { withTypes, type RiotComponent } from 'riot';
    import { cabinetReturnPath } from '../cabinet/paths';
    import { login } from '../client/api';

    interface Props {
      password?: string;
    }

    interface State {
      error: string;
    }

    export default withTypes<RiotComponent<Props, State>>(() => ({
      state: { error: '' },
      async send(event: Event) {
        event.preventDefault();
        const form = event.currentTarget as HTMLFormElement;
        const data = new FormData(form);
        const result = await login(
          String(data.get('email') ?? ''),
          String(data.get('password') ?? ''),
        );
        if (!result.ok) {
          this.update({ error: result.error });
          return;
        }
        const next = new URLSearchParams(window.location.search).get('next') ?? '';
        window.location.assign(cabinetReturnPath(next));
      },
    }));
  </script>

  <style>
    :host form {
      display: grid;
      gap: 14px;
    }

    label {
      display: grid;
      gap: 6px;
      font-size: 13px;
      font-weight: 600;
    }

    input,
    button {
      font: inherit;
    }

    input {
      width: 100%;
      box-sizing: border-box;
      padding: 10px 12px;
      border: 1px solid var(--switch-border);
      border-radius: 8px;
      background: var(--switch-bg);
      color: var(--card-text);
    }

    button {
      width: fit-content;
      background: var(--main-bg);
      color: var(--text-on-main);
      border: 0;
      border-radius: 8px;
      padding: 10px 16px;
      font-weight: 600;
      cursor: pointer;
    }

    p {
      margin: 0;
      color: var(--danger);
      font-size: 14px;
    }
  </style>
</login-form>
