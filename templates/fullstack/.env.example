# create-riot-app writes this file to .env. Replace SESSION_SECRET before a real deploy.
# Outside production, a missing .env still boots with demo defaults (password "demo").
SESSION_SECRET=replace-me-with-a-long-random-string
DEMO_PASSWORD=demo
PORT=3000
# Required when NODE_ENV=production (`bun run start` and Docker).
PUBLIC_ORIGIN=http://localhost:3000

# Production API docs stay unmounted until both values are set.
# The server then protects /api/docs and /api/openapi.json with HTTP basic auth.
# DOCS_USER=docs
# DOCS_PASSWORD=replace-me
